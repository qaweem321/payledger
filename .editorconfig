root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,csproj,slnx,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Test method names read as sentences (Deposit_credits_wallet...).
dotnet_diagnostic.CA1707.severity = none

# EF Core migrations are generated code.
[**/Migrations/*.cs]
generated_code = true

# Integration tests make many short HTTP calls; passing the test's token to each adds noise, not safety.
[tests/**.cs]
dotnet_diagnostic.xUnit1051.severity = none
